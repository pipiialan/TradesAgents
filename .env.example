# ── Proveedor activo ─────────────────────────────────────────────────────────
# Opciones: groq | openai | gemini | anthropic | openrouter | custom
PROVIDER=groq

# ── API keys (pega SOLO la del proveedor que uses; deja las demás vacías) ─────
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Solo si PROVIDER=custom (Qwen / MiniMax / local OpenAI-compatible):
LLM_API_KEY=
LLM_API_BASE=

# ── Overrides de modelo (opcional; vacío = default del proveedor) ─────────────
LLM_MODEL=
LLM_MODEL_JEFE=

# ── Búsqueda web para el analista de noticias (opcional) ─────────────────────
TAVILY_API_KEY=
